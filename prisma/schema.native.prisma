  input       String
  rawResponse String   @default("")
  field       String?
  operation   String?
  value       String?
  isSuccess   Boolean  @default(false)
  error       String?
  latencyMs   Int?
  modelName   String?
  createdAt   DateTime @default(now())
}

model CommandAlias {
  id        String   @id @default(cuid())
  key       String
  value     String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([category, key])
  @@index([category])
}

