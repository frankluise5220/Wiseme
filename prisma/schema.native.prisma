  updatedAt              DateTime                @default(now()) @updatedAt
  ProductMaster          InsuranceProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: SetNull)
  Account                Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Household              Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  Institution            Institution?            @relation("InsuranceProductInsurer", fields: [institutionId], references: [id], onDelete: SetNull)
  OwnerGroup             AccountGroup?           @relation(fields: [ownerGroupId], references: [id], onDelete: SetNull)
  PolicyholderPerson     Institution?            @relation("InsuranceProductPolicyholder", fields: [policyholderPersonId], references: [id], onDelete: SetNull)
  InsuredUser            User?                   @relation("InsuranceProduct_insuredUserIdToUser", fields: [insuredUserId], references: [id], onDelete: SetNull)
  InsuredPerson          Institution?            @relation("InsuranceProductInsured", fields: [insuredPersonId], references: [id], onDelete: SetNull)
  TxRecord               TxRecord[]
  InsuranceTransaction   InsuranceTransaction[]

  @@unique([householdId, accountId, name, policyNo])
  @@index([productMasterId])
  @@index([householdId, productType])
  @@index([householdId, accountingType])
  @@index([accountId])
  @@index([institutionId])
  @@index([ownerGroupId])
  @@index([policyholderPersonId])
  @@index([insuredUserId])
  @@index([insuredPersonId])
}

model TxRecord {
  id                          String                      @id @default(cuid())
  date                        DateTime
  postedAt                    DateTime?
  type                        TransactionType
  amount                      Decimal
  accountId                   String
  accountName                 String
  toAccountId                 String?
  toAccountName               String?
  categoryId                  String?
  categoryName                String?
  fundCode                    String?
  fundProductType             FundProductType?
  metalTypeId                 String?
  metalTypeName               String?
  metalUnitId                 String?
  metalUnitName               String?
  metalQuantity               Decimal?
  metalUnitPrice              Decimal?
  metalFee                    Decimal?
  confirmDate                 DateTime?
  statementMonth              String?
  note                        String?
  toNote                      String?
  deletedAt                   DateTime?
  importBatchId               String?
  householdId                 String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @default(now()) @updatedAt
  dayOrder                    Int                         @default(0)
  currency                    String                      @default("CNY")
  paymentChannelId            String?
  paymentChannelName          String?
  counterpartyInstitutionId   String?
  counterpartyInstitutionName String?
  status                      TransactionStatus           @default(posted)
  fundArrivalAmount           Decimal?
  fundArrivalDate             DateTime?
  depositAnnualRate           Decimal?
  depositInterest             Decimal?
  depositSourceEntryId        String?
  fundSourceEntryId           String?
  debtPrincipalAmount         Decimal?
  debtInterestAmount          Decimal?
  debtFeeAmount               Decimal?
  fundConfirmDate             DateTime?
  fundFee                     Decimal?
  fundNav                     Decimal?
  fundSubtype                 FundSubtype?
  fundUnits                   Decimal?
  realizedProfit              Decimal?
  regularInvestPlanId         String?
  creditCardInstallmentPlanId String?
  installmentNo               Int?
  installmentTotal            Int?
  installmentPrincipal        Decimal?
  installmentInterest         Decimal?
  installmentRole             String?
  fundName                    String?
  wealthProductId             String?
  insuranceProductId          String?
  insuranceAction             String?
  insuranceProductName        String?
  source                      String?                     @default("manual")
  entryOrigin                 String?                     @default("manual")
  Attachment                  Attachment[]
  EntryTag                    EntryTag[]
  account                     Account                     @relation("transactions_accountIdToAccount", fields: [accountId], references: [id])
  Category                    Category?                   @relation(fields: [categoryId], references: [id])
  Household                   Household?                  @relation(fields: [householdId], references: [id])
  ImportBatch                 ImportBatch?                @relation(fields: [importBatchId], references: [id])
  InsuranceProduct            InsuranceProduct?           @relation(fields: [insuranceProductId], references: [id], onDelete: SetNull)
  WealthProduct               WealthProduct?              @relation(fields: [wealthProductId], references: [id], onDelete: SetNull)
  PreciousMetalType           PreciousMetalType?          @relation(fields: [metalTypeId], references: [id], onDelete: SetNull)
  PreciousMetalUnit           PreciousMetalUnit?          @relation(fields: [metalUnitId], references: [id], onDelete: SetNull)
  toAccount                   Account?                    @relation("transactions_toAccountIdToAccount", fields: [toAccountId], references: [id])
  CreditCardInstallmentPlan   CreditCardInstallmentPlan?  @relation("CreditCardInstallmentEntries", fields: [creditCardInstallmentPlanId], references: [id], onDelete: Cascade)
  CreditCardInstallmentSource CreditCardInstallmentPlan[] @relation("CreditCardInstallmentSource")
  EntryBusinessLinkCash       EntryBusinessLink[]         @relation("EntryBusinessLink_cashEntry")
  EntryBusinessLinkBusiness   EntryBusinessLink[]         @relation("EntryBusinessLink_businessEntry")
  FxConversionFromEntry       FxConversion?               @relation("FxConversion_fromEntry")
  FxConversionToEntry         FxConversion?               @relation("FxConversion_toEntry")

  @@index([accountId, date])
  @@index([accountId, date, dayOrder])
  @@index([accountId, postedAt])
  @@index([accountId, statementMonth])
  @@index([counterpartyInstitutionId])
  @@index([deletedAt])
  @@index([depositSourceEntryId])
  @@index([fundSourceEntryId])
  @@index([insuranceProductId])
  @@index([wealthProductId])
  @@index([metalTypeId])
  @@index([metalUnitId])
  @@index([regularInvestPlanId])
  @@index([creditCardInstallmentPlanId, installmentNo])
  @@index([toAccountId, fundProductType])
  @@index([toAccountId, date, dayOrder])
  @@index([type])
  @@map("transactions")
}

model FxConversion {
  id            String   @id @default(cuid())
  date          DateTime
  householdId   String
  fromEntryId   String   @unique
  toEntryId     String   @unique
  fromAccountId String
  toAccountId   String
  fromCurrency  String
  toCurrency    String
  fromAmount    Decimal
  toAmount      Decimal
  exchangeRate  Decimal
  feeAmount     Decimal?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  Household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  FromAccount Account   @relation("FxConversion_fromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  ToAccount   Account   @relation("FxConversion_toAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  FromEntry   TxRecord  @relation("FxConversion_fromEntry", fields: [fromEntryId], references: [id], onDelete: Cascade)
  ToEntry     TxRecord  @relation("FxConversion_toEntry", fields: [toEntryId], references: [id], onDelete: Cascade)

  @@index([householdId, date])
  @@index([fromAccountId, date])
  @@index([toAccountId, date])
  @@index([fromCurrency, toCurrency])
}

model UndoOperation {
  id          String    @id @default(cuid())
  householdId String
  userId      String?
  action      String
  label       String
  snapshots   Json
  entryIds    Json
  createdAt   DateTime  @default(now())
  undoneAt    DateTime?

  @@index([householdId, userId, createdAt])
}

model CommandTestResult {
  id          String   @id @default(cuid())
